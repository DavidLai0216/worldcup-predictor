# Server
PORT=3000

# TheSportsDB has a public test key. Use your own key for production stability.
SPORTSDB_API_KEY=3

# Polymarket Gamma API is public.
POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com

# Optional: Kalshi API. Leave blank to disable Kalshi fetches.
KALSHI_API_BASE=https://api.elections.kalshi.com
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY=
